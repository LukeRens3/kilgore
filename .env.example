# Copy to .env.local and set the host. .env.local is gitignored.
#
# The server owns the database *address* and nothing else. There is no service
# account: every visitor signs in with their own MySQL user, and that user's
# grants decide what they can see and run. To give someone access, CREATE USER
# and GRANT on the database - there is no application-level user list.

DB_HOST=kilgore.ch9jei5g8isa.us-east-2.rds.amazonaws.com
DB_PORT=3306

# TLS is on unless set to "false". Verification is skipped unless DB_SSL_CA
# points at the Amazon RDS CA bundle:
#   https://truststore.pki.rds.amazonaws.com/us-east-2/us-east-2-bundle.pem
DB_SSL=true
# DB_SSL_CA=
