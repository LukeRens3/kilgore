# Copy to .env.local and fill in the password. .env.local is gitignored.
# Without DB_HOST/DB_USER the app falls back to its built-in mock schema.

DB_HOST=kilgore.ch9jei5g8isa.us-east-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
# Optional: the schema the pool opens with. The UI can switch databases freely.
DB_NAME=

# TLS is on unless set to "false". Verification is skipped unless DB_SSL_CA
# points at the Amazon RDS CA bundle:
#   https://truststore.pki.rds.amazonaws.com/us-east-2/us-east-2-bundle.pem
DB_SSL=true
# DB_SSL_CA=
